{
  "name": "linkedin-profile-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented LinkedIn profile extraction API",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tsunade-106/LinkedinAPI.git"
  },
  "bugs": {
    "url": "https://github.com/Tsunade-106/LinkedinAPI/issues"
  },
  "homepage": "https://github.com/Tsunade-106/LinkedinAPI#readme",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.5",
    "lru-cache": "^11.5.3",
    "pino": "^10.3.1",
    "playwright": "1.63.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
